# ===========================================================================
# App RBAC materialization — the fop-rbac Cloudflare D1 database.
#
# Terraform CREATES the database; it does NOT write rows (the Cloudflare
# provider has no D1 row/SQL resource). The resolved per-user application roles
# are synced into it by CI (.github/workflows/sync-rbac-d1.yml) via
# `wrangler d1 execute`, generated by scripts/render-d1.py. This is the one
# difference from the KV path (kv.tf), where Terraform writes values directly.
#
# Consumer model: internal Cloudflare Worker apps (e.g. leave-tracker) BIND this
# database READ-ONLY (a second d1_databases binding) and authorize with:
#     SELECT role FROM app_role WHERE email = ?1 AND app = 'leave-tracker';
# They read at runtime, so a role change never requires the app to redeploy —
# CI re-syncs the rows and the next request sees the new role.
#
# Read-only is by CONTRACT, not platform ACL: a D1 binding can technically
# write, so the consumer contract (docs/leave-tracker-integration.md) mandates
# SELECT-only. fop-rbac's CI is the sole writer.
#
# TOKEN SCOPE: creating the DB here (and the CI sync) needs a Cloudflare API
# token with **D1: Edit** + Account: Read. Add D1:Edit to CLOUDFLARE_API_TOKEN,
# or mint a dedicated token — it is NOT covered by the KV or Access tokens.
#
# OWNERSHIP (today vs later): while HCP Terraform is NOT yet wired for this repo,
# the D1 is provisioned by the GitHub Action (.github/workflows/sync-rbac-d1.yml,
# create-if-missing) so you can deploy without HCP. This file is the *target* IaC.
# When HCP goes live for Cloudflare, run `terraform import cloudflare_d1_database.
# fop_rbac[0] <database_id>` and remove the create step from the Action (leave the
# row-sync) so there is a single owner. Do NOT `terraform apply` this before the
# import, or it will try to create a second database with the same name.
# ===========================================================================

resource "cloudflare_d1_database" "fop_rbac" {
  count      = var.enable_cloudflare ? 1 : 0
  account_id = var.cloudflare_account_id
  name       = "fop-rbac"

  # Recreating the DB changes its id and breaks every consumer's binding
  # (fleet-wide authZ outage — fail-closed apps deny everyone). Deliberate,
  # coordinated event only. Note: destroying it also loses the synced rows,
  # but CI rebuilds them on the next run.
  lifecycle {
    prevent_destroy = true
  }
}
